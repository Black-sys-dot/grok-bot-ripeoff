#!/usr/bin/env python3
"""Store a root command for later approval. Does not run it."""

import json
import re
import sys
from pathlib import Path

PENDING = Path("/var/lib/grok-root/pending")


def main() -> None:
    approval_id = sys.argv[1]
    if not re.fullmatch(r"[a-f0-9]{32}", approval_id):
        raise SystemExit("bad id")
    data = json.load(sys.stdin)
    command = str(data.get("command", "")).strip()
    token_hash = str(data.get("token_hash", ""))
    reason = str(data.get("reason", ""))[:500]
    if not command or not re.fullmatch(r"[a-f0-9]{64}", token_hash):
        raise SystemExit("bad request")
    PENDING.mkdir(parents=True, exist_ok=True)
    PENDING.chmod(0o700)
    dest = PENDING / f"{approval_id}.json"
    dest.write_text(
        json.dumps(
            {
                "command": command,
                "reason": reason,
                "token_hash": token_hash,
                "status": "pending",
            }
        )
    )
    dest.chmod(0o600)


if __name__ == "__main__":
    main()
